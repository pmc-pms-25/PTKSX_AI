# Copy file nay thanh .env roi sua gia tri.

# Cong ma portal lang nghe. Doi thanh 80 neu muon truy cap khong kem so cong.
PORT=8080

# Mat khau quan tri BAN DAU, chi dung khi chua dat mat khau trong trang quan tri.
# Cach thuong dung la vao /#/admin -> Cai dat -> "Mat khau quan tri" de dat,
# vi cach do bam mat khau truoc khi luu va doi duoc ngay khong can khoi dong lai.
# Da dat mat khau trong trang quan tri thi dong nay het tac dung.
ADMIN_PASSWORD=
